# Server Configuration
PORT=8080

# Database Configuration
DATABASE_URL=sqlite://data/db/sqlite.db
LOG_DATABASE_URL=sqlite://data/db/log.db

# Email Configuration
MAIL_SERVER=smtp.example.com
MAIL_USERNAME=user@example.com
MAIL_PASSWORD=your_password
MAIL_FROM=user@example.com

# WeChat Configuration
WX_APPID_CLIPBOARD=your_appid
WX_SECRET_CLIPBOARD=your_secret
WX_APPID_ROLL=your_appid
WX_SECRET_ROLL=your_secret

# AI Configuration (Vendor-agnostic)
AI_API_KEY=your_api_key
AI_MODEL=doubao-seed-2-0-mini-260428
AI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
# AI Secretary Agent: 只读挂载的站点根目录(服务器 www 产物)，read 工具仅可读此目录
WWW_ROOT=/srv/www
# AI 工具开关：0/false 关闭 read 工具(降级为纯问答)，默认开启
AI_TOOLS_ENABLED=1
